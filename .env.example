# Copy this file to .env and fill in your own key. .env is gitignored.
#   cp .env.example .env

# Any OpenAI-compatible chat-completions provider works here.
# Default below is Mistral's free tier: https://console.mistral.ai
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=ministral-8b-latest

# Request tuning. 45s is generous: a 3-clause suggestion measured ~6s.
LLM_TIMEOUT_S=45
LLM_MAX_TOKENS=900

# Notes on model choice:
#  - mistral-small-latest returns HTTP 429 on the free tier, so it is not the default.
#  - ministral-8b-latest answers in ~6s and reliably honours JSON response_format.
#  - Groq alternative: LLM_BASE_URL=https://api.groq.com/openai/v1
#  - Local alternative: LLM_BASE_URL=http://localhost:11434/v1 with LLM_MODEL=mistral
#    (Ollama; LLM_API_KEY can be any non-empty string)
